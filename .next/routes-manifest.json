{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/employer/jobs/[id]",
      "regex": "^/api/employer/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/employer/jobs/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/employer/jobs/[id]",
      "regex": "^/employer/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/employer/jobs/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jobs/[id]",
      "regex": "^/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/jobs/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/admin/dashboard",
      "regex": "^/admin/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/dashboard(?:/)?$"
    },
    {
      "page": "/api/cron/expireJobs",
      "regex": "^/api/cron/expireJobs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/cron/expireJobs(?:/)?$"
    },
    {
      "page": "/api/employer/dashboard",
      "regex": "^/api/employer/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/employer/dashboard(?:/)?$"
    },
    {
      "page": "/api/jobs",
      "regex": "^/api/jobs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/jobs(?:/)?$"
    },
    {
      "page": "/api/payments/momo",
      "regex": "^/api/payments/momo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/payments/momo(?:/)?$"
    },
    {
      "page": "/api/payments/stripe",
      "regex": "^/api/payments/stripe(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/payments/stripe(?:/)?$"
    },
    {
      "page": "/api/upload",
      "regex": "^/api/upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/upload(?:/)?$"
    },
    {
      "page": "/api/verifyEmployer",
      "regex": "^/api/verifyEmployer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/verifyEmployer(?:/)?$"
    },
    {
      "page": "/employer/dashboard",
      "regex": "^/employer/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/employer/dashboard(?:/)?$"
    },
    {
      "page": "/jobs",
      "regex": "^/jobs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/jobs(?:/)?$"
    },
    {
      "page": "/upload",
      "regex": "^/upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/upload(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}